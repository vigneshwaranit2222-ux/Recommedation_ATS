# =============================================================================
# AI Recruitment & Hiring Suite — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# The `.env` file is loaded by pydantic-settings (app/config.py).
# NEVER commit the real `.env` file to version control.
# =============================================================================

# --- Database (PostgreSQL via asyncpg) ---------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Local dev example:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ats_suite
# Set to true to echo SQL statements to stdout (dev/debug only):
SQL_ECHO=false

# --- Hugging Face free-tier inference (OpenAI-compatible router) -------------
# Obtain a token from: https://huggingface.co/settings/tokens
# Use a "read" token — it's sufficient for inference calls.
HF_API_TOKEN=hf_your_token_here

# The unified router base URL. Do NOT use the legacy
# api-inference.huggingface.co/models/<model> endpoint.
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1

# Chat completions model id. VERIFY this model is live on the free tier
# before deploying: https://huggingface.co/models?inference_provider=all&pipeline_tag=text-generation
# Free-tier model availability rotates — swap this value without code changes.
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Generation parameters:
HF_CHAT_MAX_TOKENS=1024
HF_CHAT_TEMPERATURE=0.3
HF_REQUEST_TIMEOUT=60

# --- ChromaDB (local persistent vector store) --------------------------------
# Directory where Chroma persists its HNSW index + metadata to disk.
CHROMA_PERSIST_DIR=./chroma_data
# Collection name for job documents.
CHROMA_COLLECTION_JOBS=company_jobs

# --- JWT auth (placeholders — wiring is out of scope for this pass) ----------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30